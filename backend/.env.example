# ─── RailOpt AI Backend — Environment Variables ──────────────────────────────
# Copy this file to backend/.env (or set these as system environment variables)
# NEVER commit .env to Git

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/railopt

# Server Port
SERVER_PORT=8080

# Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# ─── Live Train Tracking & RailRadar API ──────────────────────────────
# Set to 'railradar' to enable live upstream tracking, or 'mock' for simulation
TRAIN_TRACKING_PROVIDER=mock
# Your RailRadar API Key (Header: x-api-key)
RAILRADAR_API_KEY=

# ─── Gemini AI Explanation Layer ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

